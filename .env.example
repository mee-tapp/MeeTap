# Meetap – ortam değişkenleri şablonu
# Kopyala: cp .env.example .env   (gerçek .env dosyası git'e girmez)

# --- Supabase (Project Settings → API) ---------------------------------------
# Tarayıcıya da gider (VITE_ öneki şart). Anon key herkese açık olabilir.
VITE_SUPABASE_URL=https://XXXX.supabase.co
VITE_SUPABASE_ANON_KEY=

# SADECE sunucu tarafı. Asla VITE_ öneki verme, asla tarayıcıya gönderme.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings → Database → Connection string (URI). Migration'ı ve veri
# yüklemeyi terminalden çalıştırmak için gerekli.
SUPABASE_DB_URL=postgresql://postgres.XXXX:PAROLA@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- LLM ----------------------------------------------------------------------
# LLM_PROVIDER: deepseek | gemini | groq | none  (none → sadece kural tabanlı çözümleyici)
LLM_PROVIDER=deepseek
# platform.deepseek.com → API keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Venue Intelligence (optional ranking component) ---------------------------
# false/missing (default) → existing MeeTap ranking, unchanged.
# true → also weighs real review evidence (venue_intelligence table) when the
# user actually asked for something subjective AND a venue has data for it.
VENUE_INTELLIGENCE_ENABLED=false

# --- Harita / rota (ileride) ---------------------------------------------------
# OpenRouteService ücretsiz anahtar (Etap 3'te gerekli, şimdilik boş kalabilir)
OPENROUTESERVICE_API_KEY=

# --- Uygulama ------------------------------------------------------------------
# Varsayılan şehir merkezi (konum izni verilmezse): Istanbul | Baku
DEFAULT_CITY=Istanbul

# --- Yorum verisi (resmi API'ler) ---------------------------------------------
# developer-tripadvisor.com → Content API → API key (ayda 5.000 çağrı ücretsiz; kredi kartı + günlük bütçe limiti ister)
TRIPADVISOR_API_KEY=
# Tripadvisor Terra API (terra.tripadvisor.com) — scripts/enrich/terra-smoke.mjs
TERRA_API_KEY=
# Google Places (New) – ileride; yorumlar Enterprise+Atmosphere SKU, ayda 1.000 çağrı ücretsiz
GOOGLE_PLACES_API_KEY=
